{
  "expo": {
    "name": "Talento",
    "slug": "talento-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talento.app"
    },
    "android": {
      "package": "com.talento.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-av",
      "expo-camera",
      "expo-image-picker",
      "expo-local-authentication",
      "expo-font"
    ],
    "scheme": "talento",
    "extra": {
      "eas": {
        "projectId": "f2672cdf-7d0a-419f-b073-e7112039518e"
      }
    }
  }
}
